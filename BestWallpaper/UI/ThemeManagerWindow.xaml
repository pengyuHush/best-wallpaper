<Window x:Class="BestWallpaper.UI.ThemeManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="主题管理"
        Width="900" Height="680"
        MinWidth="760" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="16,14,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 标题 -->
        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="主题管理" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock x:Name="SummaryText" Foreground="{StaticResource MutedBrush}" FontSize="12"
                       VerticalAlignment="Center" Margin="12,4,0,0" />
        </DockPanel>

        <!-- 新增 -->
        <Border Grid.Row="1" Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="新增主题" FontWeight="SemiBold" Margin="0,0,0,8" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="NewDisplay" Grid.Column="0" Margin="0,0,8,0" ToolTip="中文名，例如 猫咪" />
                    <TextBox x:Name="NewQuery" Grid.Column="1" Margin="0,0,8,0" ToolTip="英文搜索标签，例如 cat"
                             LostFocus="NewQuery_LostFocus" />
                    <Button Grid.Column="2" Content="翻译" Padding="12,4" Margin="0,0,8,0" Click="Translate_Click" />
                    <Button Grid.Column="3" Content="添加" Padding="12,4" Click="Add_Click" />
                </Grid>
                <TextBlock x:Name="AddStatus" Style="{StaticResource Hint}" Text="中文名填好后离开标签框会自动翻译；也可手填标签。" />
            </StackPanel>
        </Border>

        <!-- 搜索 -->
        <DockPanel Grid.Row="2" Margin="0,4,0,8">
            <TextBlock Text="搜索" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="SearchBox" Width="260" HorizontalAlignment="Left" TextChanged="Search_TextChanged" />
            <TextBlock Text="（匹配中文名或标签；清空显示全部）" Foreground="{StaticResource MutedBrush}"
                       FontSize="12" VerticalAlignment="Center" Margin="10,3,0,0" />
        </DockPanel>

        <!-- 列表 -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="10">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ListPanel" />
            </ScrollViewer>
        </Border>

        <!-- 底部 -->
        <DockPanel Grid.Row="4" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
            <Button Content="关闭" Padding="16,5" HorizontalAlignment="Right" Click="Close_Click" />
        </DockPanel>
    </Grid>
</Window>
