<Window x:Class="BestWallpaper.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="每日壁纸 · 设置"
        Width="680" Height="800"
        MinWidth="600" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <Grid Margin="16,14,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="每日壁纸" FontSize="19" FontWeight="Bold" VerticalAlignment="Center" />
            <TextBlock x:Name="VersionText" Foreground="{StaticResource MutedBrush}" FontSize="12"
                       VerticalAlignment="Center" Margin="10,4,0,0" />
        </DockPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,0" Padding="0,0,6,16">
            <StackPanel>

                <!-- 状态 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock x:Name="StatusText" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock x:Name="SubStatusText" Style="{StaticResource Hint}" />
                        <WrapPanel Margin="0,12,0,0">
                            <Button x:Name="NextBtn" Content="立即换下一张" Style="{StaticResource ActionButton}" Click="Next_Click" />
                            <Button x:Name="RefreshBtn" Content="重抓今日 10 张" Style="{StaticResource ActionButton}" Click="Refresh_Click" />
                            <Button x:Name="PauseBtn" Content="暂停轮播" Style="{StaticResource ActionButton}" Click="Pause_Click" />
                            <Button Content="打开当前图" Style="{StaticResource ActionButton}" Click="OpenCurrent_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 主题 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="主题" Style="{StaticResource SectionTitle}" />

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="今日主题" VerticalAlignment="Center" Width="80" />
                            <ComboBox x:Name="TodayCombo" IsEditable="True" Width="240" Margin="0,0,8,0" />
                            <Button Content="应用并重抓" Padding="12,4" Margin="0,0,8,0" Click="ApplyToday_Click" />
                            <Button Content="主题管理…" Padding="12,4" Click="OpenThemeManager_Click" />
                        </StackPanel>
                        <TextBlock x:Name="TodayHint" Style="{StaticResource Hint}" Margin="0,6,0,0" />

                        <Separator Margin="0,14,0,12" />

                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="DailyRadio" Content="每天随机主题" GroupName="mode" VerticalAlignment="Center"
                                         Checked="ThemeMode_Changed" />
                            <RadioButton x:Name="FixedRadio" Content="固定使用我的主题" GroupName="mode" Margin="18,0,0,0"
                                         VerticalAlignment="Center" Checked="ThemeMode_Changed" />
                        </StackPanel>
                        <ComboBox x:Name="ThemeCombo" Margin="0,10,0,0" Width="260" HorizontalAlignment="Left"
                                  SelectionChanged="ThemeCombo_Changed" />

                        <TextBlock Text="优先级：今日主题 → 固定主题 → 每天随机。今日主题只在当天有效，明天自动失效。"
                                   Style="{StaticResource Hint}" Margin="0,8,0,0" />

                        <TextBlock Text="内置方向（取消勾选可整体停用）" FontWeight="SemiBold" Margin="0,14,0,6" />
                        <WrapPanel x:Name="DirectionPanel" />
                    </StackPanel>
                </Border>

                <!-- 轮播 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="轮播" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="切换间隔" VerticalAlignment="Center" />
                            <ComboBox x:Name="RotationCombo" IsEditable="True" Width="90" Margin="10,0,6,0"
                                      SelectionChanged="Rotation_Changed" LostFocus="Rotation_LostFocus" />
                            <TextBlock Text="分钟（1–1440）" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                        <TextBlock Text="当日池内打乱顺序播放，播完一轮再从头。检测到壁纸被别的程序改动会自动暂停。"
                                   Style="{StaticResource Hint}" />
                    </StackPanel>
                </Border>

                <!-- 网络 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="网络" Style="{StaticResource SectionTitle}" />
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="代理" VerticalAlignment="Center" />
                            <ComboBox x:Name="ProxyCombo" Width="160" Margin="10,0,10,0" SelectionChanged="Proxy_Changed" />
                            <TextBox x:Name="ProxyAddressBox" Width="200" LostFocus="Proxy_LostFocus" />
                        </StackPanel>
                        <TextBlock x:Name="ProxyHint" Style="{StaticResource Hint}" />
                    </StackPanel>
                </Border>

                <!-- 启动 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="启动" Style="{StaticResource SectionTitle}" />
                        <CheckBox x:Name="AutostartCheck" Content="开机自动启动（写入当前用户的 Run 键，不需要管理员权限）"
                                  Click="Autostart_Click" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="自启动后延迟" VerticalAlignment="Center" />
                            <TextBox x:Name="DelayBox" Width="70" Margin="10,0,6,0" LostFocus="Delay_LostFocus" />
                            <TextBlock Text="秒再开始（避免抢开机资源）" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 存储 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="存储" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="UsageText" TextWrapping="Wrap" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="打开 data 目录" Style="{StaticResource ActionButton}" Click="OpenData_Click" />
                            <Button Content="打开收藏夹" Style="{StaticResource ActionButton}" Click="OpenFavorites_Click" />
                            <Button Content="清理旧池子" Style="{StaticResource ActionButton}" Click="Cleanup_Click" />
                        </WrapPanel>
                        <TextBlock Text="保留最近 7 天池子，总占用超过 2GB 时从最旧的开始删；收藏永不删除。"
                                   Style="{StaticResource Hint}" />
                    </StackPanel>
                </Border>

                <!-- 收藏 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="收藏" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="FavoritesEmptyText" Text="还没有收藏。托盘菜单「收藏这张」会把当前壁纸复制到 data\favorites。"
                                   Style="{StaticResource Hint}" Margin="0,0,0,8" />
                        <ItemsControl x:Name="FavoritesList">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="152" Margin="0,0,10,10" Background="White"
                                            BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                            CornerRadius="8" Padding="6">
                                        <StackPanel>
                                            <Border Height="86" Background="#EEF0F3" CornerRadius="4" ClipToBounds="True">
                                                <Image Source="{Binding Image}" Stretch="UniformToFill" />
                                            </Border>
                                            <TextBlock Text="{Binding Title}" FontSize="11" Margin="0,6,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Sub}" FontSize="10" Foreground="{StaticResource MutedBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Button Content="移除" FontSize="11" Padding="6,2" Margin="0,6,0,0"
                                                    HorizontalAlignment="Left" Click="RemoveFavorite_Click" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 排除 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="排除列表" Style="{StaticResource SectionTitle}" />
                        <TextBlock x:Name="ExcludedEmptyText" Text="没有被排除的壁纸。" Style="{StaticResource Hint}" Margin="0,0,0,8" />
                        <ListBox x:Name="ExcludedList" Height="110" />
                        <Button Content="恢复选中的" Padding="10,4" Margin="0,8,0,0" HorizontalAlignment="Left"
                                Click="RestoreExcluded_Click" />
                    </StackPanel>
                </Border>

                <!-- 关于 -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="关于" Style="{StaticResource SectionTitle}" />
                        <TextBlock TextWrapping="Wrap" Text="壁纸来源：wallhaven（主，需代理）与 Bing 每日图（备用，直连可用）。图片版权归原作者，仅个人桌面使用。" />
                        <WrapPanel Margin="0,10,0,0">
                            <Button Content="打开日志" Style="{StaticResource ActionButton}" Click="OpenLog_Click" />
                            <Button Content="wallhaven.cc" Style="{StaticResource ActionButton}" Click="OpenWallhaven_Click" />
                            <Button Content="bing.com" Style="{StaticResource ActionButton}" Click="OpenBing_Click" />
                            <Button Content="退出程序" Style="{StaticResource ActionButton}" Click="Exit_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
